NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

NEXT_PUBLIC_PORTAL_NAME="Satu Data Kabupaten Bulungan"
NEXT_PUBLIC_PORTAL_TAGLINE="Akurat - Mutakhir - Terpadu - Bertanggung Jawab"

DATA_SOURCE_MODE=ckan
CKAN_BASE_URL=https://data.domainanda.go.id
CKAN_API_KEY=
CKAN_INFOGRAFIS_PACKAGE_ID=
CKAN_INFOGRAFIS_PACKAGE_NAME=

INFOGRAFIS_CACHE_TTL_MS=21600000
INFOGRAFIS_HTML_MAX_PAGES=8

INTERNAL_BASIC_AUTH_USER=admin
INTERNAL_BASIC_AUTH_PASSWORD=ubah-password-kuat

WORKFLOW_AUDIT_RETENTION_DAYS=90
WORKFLOW_AUDIT_MAX_ENTRIES=500
