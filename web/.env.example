NEXT_PUBLIC_PORTAL_NAME="Satu Data Kabupaten Bulungan"
NEXT_PUBLIC_PORTAL_TAGLINE="Akurat · Mutakhir · Terpadu · Bertanggung Jawab"
NEXT_PUBLIC_APP_NAME="Portal Satu Data Kabupaten Bulungan"
NEXT_PUBLIC_APP_REGION="Kabupaten Bulungan"

# mock | ckan
DATA_SOURCE_MODE=ckan

# disarankan: URL CKAN untuk sisi browser + server
NEXT_PUBLIC_CKAN_BASE_URL=http://localhost:5000

# fallback lama (tetap didukung untuk kompatibilitas)
CKAN_BASE_URL=http://localhost:5000

# server-only: dibutuhkan untuk upload, seed helper, dan endpoint internal yang memodifikasi data CKAN
CKAN_API_KEY=

# opsional: package/name CKAN khusus metadata infografis
CKAN_INFOGRAFIS_PACKAGE_ID=
CKAN_INFOGRAFIS_PACKAGE_NAME=

# cache + scraping infografis (legacy fallback)
INFOGRAFIS_CACHE_TTL_MS=21600000
INFOGRAFIS_HTML_MAX_PAGES=8

# basic auth proteksi panel internal (/internal/workflow)
INTERNAL_BASIC_AUTH_USER=admin
INTERNAL_BASIC_AUTH_PASSWORD=bulungan123

# retention + rotation audit lokal
WORKFLOW_AUDIT_RETENTION_DAYS=90
WORKFLOW_AUDIT_MAX_ENTRIES=500

