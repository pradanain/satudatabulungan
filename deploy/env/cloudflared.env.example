# Token tunnel dari Cloudflare Zero Trust dashboard
TUNNEL_TOKEN=replace-with-your-tunnel-token

# Opsional: override image yang dipull oleh service web
# Format contoh:
# WEB_IMAGE=ghcr.io/<github-owner>/satudatabulungan-web:deploy-latest
WEB_IMAGE=ghcr.io/your-github-owner/satudatabulungan-web:deploy-latest
