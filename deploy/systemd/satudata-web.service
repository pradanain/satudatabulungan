[Unit]
Description=Satu Data Bulungan Web (Next.js)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/satudata/app/web
EnvironmentFile=/etc/satudata/web.env
ExecStart=/usr/bin/npm run start -- --hostname ${HOSTNAME} --port ${PORT}
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
